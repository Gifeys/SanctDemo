# Stray APK copies made when transferring builds to a phone.
*.apk

# Local dev binaries (cloudflared). Not part of the app.
tools/

# Vercel
# .vercel holds the project link; .vercel-cli holds an auth TOKEN when the
# CLI is pointed here with --global-config to work around an EXDEV rename
# failure on this machine. Neither belongs in the repository.
.vercel
.vercel-cli

# Bun is not this project's package manager. A bun.lock in the repo
# makes Vercel install with bun instead of npm.
bun.lock
bun.lockb
